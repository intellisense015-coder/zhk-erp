# Browser-safe Supabase project settings.
# These values are inlined into the browser bundle; never put a secret here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical application origin used in production invitation links and
# same-origin request validation. Example: https://erp.example.com
APP_URL=

# Optional server-only device catalog integration.
MOBILEAPI_API_KEY=

# Legacy projects may still expose this name. Prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
