# Supabase project settings.
# Use the publishable key (or the legacy anon key) only in browser-safe code.
# Never commit a service-role key or paste one into chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

