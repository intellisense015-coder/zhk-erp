# Supabase project settings.
# Use the publishable key (or the legacy anon key) only in browser-safe code.
# Never commit a service-role key or paste one into chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never use NEXT_PUBLIC_ for this key or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS origin used in invitation links in production.
APP_URL=

# Legacy projects may still expose this name. Prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
